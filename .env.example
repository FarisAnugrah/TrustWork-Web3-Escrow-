# ==========================================
# TRUSTWORK ESCROW - ENVIRONMENT VARIABLES
# ==========================================

# 1. Deployment Keys
# WARNING: NEVER use a Mainnet account with real funds!
# Export the private key from a fresh, empty Metamask account.
PRIVATE_KEY="your_64_character_hex_private_key_here"

# 2. RPC Endpoints (Optional)
# If left blank, Hardhat will use public nodes (which might be rate-limited).
# Get your free API keys from: https://alchemy.com or https://infura.io
SEPOLIA_URL="https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY_HERE"
ALCHEMY_AMOY_URL="https://polygon-amoy.g.alchemy.com/v2/YOUR_API_KEY_HERE"

# 3. Block Explorer API Keys (For Contract Verification - Optional)
# Used if you want to verify the contract source code on Etherscan
ETHERSCAN_API_KEY="your_etherscan_api_key_here"
